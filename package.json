{
  "name": "diskingressos-fase16-8-utm-focused",
  "private": true,
  "version": "16.8.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n WEB,API -c auto \"vite\" \"tsx watch server/src/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "build:web": "tsc -b && vite build",
    "start:api": "tsx server/src/index.ts",
    "db:generate:prod": "prisma generate --schema prisma/schema.postgresql.prisma",
    "db:push:prod": "prisma db push --schema prisma/schema.postgresql.prisma",
    "db:seed:prod": "tsx prisma/seed.ts",
    "deploy:prepare": "npm run db:generate:prod && npm run build:web"
  },
  "dependencies": {
    "@prisma/client": "latest",
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "latest",
    "cors": "latest",
    "express": "latest",
    "helmet": "latest",
    "jsonwebtoken": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "prisma": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
