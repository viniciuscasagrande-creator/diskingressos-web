{
  "name": "diskingressos-fase16-8-1-utm-corrected",
  "private": true,
  "version": "16.8.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n WEB,API -c auto \"vite\" \"tsx watch server/src/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "build:web": "tsc --noEmit && vite build",
    "start:api": "tsx server/src/index.ts",
    "db:generate:prod": "prisma generate --schema prisma/schema.postgresql.prisma",
    "db:push:prod": "prisma db push --schema prisma/schema.postgresql.prisma",
    "db:seed:prod": "tsx prisma/seed.ts",
    "deploy:prepare": "npm run db:generate:prod && npm run build:web",
    "check:lucide": "node scripts/check-lucide-imports.mjs",
    "validate:frontend": "npm run check:lucide && npm run build",
    "db:seed:marketing-test": "tsx prisma/seed-marketing-test.ts",
    "db:local:generate": "prisma generate --schema prisma/schema.postgresql.prisma",
    "db:local:push": "prisma db push --schema prisma/schema.postgresql.prisma",
    "db:local:seed": "tsx prisma/seed.ts && tsx prisma/seed-marketing-test.ts",
    "db:local:studio": "prisma studio --schema prisma/schema.postgresql.prisma",
    "db:local:setup": "npm run db:local:generate && npm run db:local:push && npm run db:local:seed"
  },
  "dependencies": {
    "@prisma/client": "latest",
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "latest",
    "cors": "latest",
    "express": "latest",
    "helmet": "latest",
    "jsonwebtoken": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "prisma": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
