{
  "name": "diskingressos-fase16-8-1-utm-corrected",
  "private": true,
  "version": "16.8.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n WEB,API -c auto \"vite\" \"tsx watch server/src/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "build:web": "tsc --noEmit && vite build",
    "start": "npm run db:generate:prod && npm run start:api",
    "start:api": "tsx server/src/index.ts",
    "db:generate:prod": "prisma generate --schema prisma/schema.postgresql.prisma",
    "db:push:prod": "prisma db push --schema prisma/schema.postgresql.prisma",
    "db:seed:prod": "tsx prisma/seed.ts",
    "deploy:prepare": "npm run db:generate:prod && npm run build:web",
    "check:lucide": "node scripts/check-lucide-imports.mjs",
    "validate:frontend": "npm run check:lucide && npm run build",
    "db:seed:marketing-test": "tsx prisma/seed-marketing-test.ts",
    "db:local:generate": "prisma generate --schema prisma/schema.postgresql.prisma",
    "db:local:push": "prisma db push --schema prisma/schema.postgresql.prisma",
    "db:local:seed": "tsx prisma/seed.ts && tsx prisma/seed-marketing-test.ts",
    "db:local:studio": "prisma studio --schema prisma/schema.postgresql.prisma",
    "db:local:setup": "npm run db:local:activate && npm run db:local:generate && npm run db:local:push && npm run db:local:seed",
    "db:local:activate": "node scripts/use-local-postgres.mjs",
    "db:local:check": "node scripts/check-local-marketing.mjs",
    "local:prepare": "npm run db:local:setup && npm run db:local:check",
    "local:dev": "node scripts/start-local-stack.mjs",
    "cloud:check": "node scripts/check-cloud-env.mjs",
    "cloud:db:prepare": "npm run cloud:check && npm run db:generate:prod && npm run db:push:prod",
    "cloud:start": "npm run cloud:check && npm run db:generate:prod && npm run start:api",
    "cloud:db:deploy": "npm run cloud:check && npm run db:generate:prod && prisma db push --schema prisma/schema.postgresql.prisma",
    "cloud:verify": "node scripts/verify-cloud-deploy.mjs",
    "cloud:release": "npm run cloud:db:deploy && npm run cloud:verify",
    "railway:start": "npm run db:generate:prod && npm run start:api",
    "cloud:scope:check": "node scripts/repair-cloud-scope.mjs",
    "cloud:bootstrap:demo": "tsx prisma/bootstrap-cloud-demo.ts",
    "build:vercel": "npm run verify:protected-modules && npm run db:generate:prod && npm run build && npm run verify:finance-release",
    "db:deploy:vercel": "npm run db:generate:prod && prisma db push --schema prisma/schema.postgresql.prisma",
    "verify:finance-release": "node scripts/verify-finance-release.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test --project=chromium --grep @smoke",
    "test:e2e:security": "playwright test tests/security",
    "test:e2e:visual": "playwright test tests/visual",
    "test:e2e:update": "playwright test tests/visual --update-snapshots",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:e2e:deploy": "playwright test tests/homologacao-real-vercel.spec.ts --project=chromium",
    "verify:protected-modules": "node scripts/verify-core-protected-modules.mjs",
    "test:e2e:protected": "playwright test tests/regression/protected-estornos.spec.ts --project=chromium",
    "test:e2e:protected-core": "playwright test tests/regression/protected-core-modules.spec.ts --project=chromium",
    "quality:gate": "npm run verify:protected-modules && npm run check:lucide && npm run typecheck",
    "deploy:guard:http": "node scripts/check-live-deploy.mjs",
    "deploy:guard:e2e": "playwright test tests/deploy-guard/post-vercel.spec.ts --project=chromium",
    "deploy:guard": "npm run deploy:guard:http && npm run deploy:guard:e2e",
    "homologate:vercel": "npm run quality:gate && npm run deploy:guard",
    "test:pw:master": "playwright test tests/master tests/quality tests/responsive --project=chromium",
    "test:pw:critical": "playwright test tests/master/estornos-critical.spec.ts tests/master/central-eventos-contract.spec.ts tests/regression/protected-core-modules.spec.ts --project=chromium",
    "test:pw:event-os": "playwright test tests/master/event-os-complete.spec.ts --project=chromium",
    "test:pw:runtime": "playwright test tests/quality/runtime-errors.spec.ts --project=chromium",
    "test:pw:responsive": "playwright test tests/responsive/core-responsive.spec.ts --project=chromium",
    "test:pw:all": "playwright test",
    "test:pw:prod": "playwright test tests/master tests/quality tests/responsive tests/deploy-guard --project=chromium",
    "test:pw:control-center": "node scripts/run-playwright-control-center.mjs",
    "test:pw:report": "node scripts/generate-playwright-executive-report.mjs",
    "test:pw:release-gate": "npm run quality:gate && npm run test:pw:control-center",
    "test:pw:certificate": "node scripts/certify-playwright-release.mjs",
    "test:pw:certify": "node scripts/run-playwright-release-certification.mjs",
    "release:certify": "npm run quality:gate && npm run deploy:guard:http && npm run test:pw:certify"
  },
  "dependencies": {
    "@prisma/client": "latest",
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "latest",
    "cors": "latest",
    "express": "latest",
    "helmet": "latest",
    "jsonwebtoken": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "prisma": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
