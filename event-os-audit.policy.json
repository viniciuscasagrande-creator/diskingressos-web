    },
    {
      "id": "sac",
      "name": "SAC",
      "route": "/app/sac-hub",
      "pageKey": "sac-hub",
      "component": "support/SupportPage.tsx",
      "isProtectedModule": true,
      "requiresEventContext": false
    }
  ],
  "mockPatterns": [
    "mockData",
    "demoData",
    "fakeData",
    "sampleData",
    "Math.random",
    "setTimeout",
    "TODO",
    "FIXME",
    "placeholder",
    "coming soon",
    "em breve",
    "dados simulados",
    "dados de demonstração"
  ],
  "protectedContracts": {
    "estornosCanonicalPath": "/app/finance-refunds",
    "estornosCanonicalComponent": "FinanceDisputesHubPage.tsx",
    "estornosProtectedModuleAttr": "estornos",
    "eventsCanonicalPath": "/eventos",
    "financeCanonicalPath": "/app/finance-dashboard",
    "marketingCanonicalPath": "/app/marketing-dashboard",
    "sacCanonicalPath": "/app/sac-hub"
  }
}
