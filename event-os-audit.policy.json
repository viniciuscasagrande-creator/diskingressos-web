      "route": "/eventos/:id/incidents",
      "pageKey": "event-incidents",
      "component": "EventIncidentsPage.tsx",
      "isProtectedModule": false,
      "requiresEventContext": true
    },
    {
      "id": "event-day-command",
      "name": "Event Day Command",
      "route": "/eventos/:id/day-command",
      "pageKey": "event-day-command",
      "component": "EventDayCommandPage.tsx",
      "isProtectedModule": false,
      "requiresEventContext": true
    },
    {
      "id": "revenue-pricing",
