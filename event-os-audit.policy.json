{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "policyVersion": "26.17.1-2026-09-04",
  "name": "Event OS Audit & Certification Policy",
  "scoringWeights": {
    "ui": 15,
    "navigation": 15,
    "buttons": 10,
    "api": 15,
    "realData": 15,
    "tenantRbac": 15,
    "errorHandling": 5,
    "playwright": 10
  },
  "classificationThresholds": {
    "OPERACIONAL": { "min": 90, "max": 100 },
    "QUASE_PRONTO": { "min": 75, "max": 89 },
    "PARCIAL": { "min": 50, "max": 74 },
    "CRITICO": { "min": 25, "max": 49 },
    "NAO_OPERACIONAL": { "min": 0, "max": 24 }
  },
  "modules": [
    {
      "id": "events-central",
      "name": "Central de Eventos",
      "route": "/eventos",
      "pageKey": "events",
      "component": "EventsPage.tsx",
      "isProtectedModule": true,
      "requiresEventContext": false
    },
    {
      "id": "cockpit-360",
      "name": "Cockpit 360",
      "route": "/eventos/:id",
      "pageKey": "event-command-center",
      "component": "EventCommandCenterPage.tsx",
      "isProtectedModule": false,
      "requiresEventContext": true
    },
    {
      "id": "global-search",
      "name": "Global Search",
      "route": "/eventos/:id/search",
      "pageKey": "event-global-search",
      "component": "EventGlobalSearchPage.tsx",
      "isProtectedModule": false,
      "requiresEventContext": true
    },
    {
      "id": "inventory",
      "name": "Inventário",
      "route": "/eventos/:id/inventory",
      "pageKey": "event-inventory",
      "component": "EventInventoryPage.tsx",
      "isProtectedModule": false,
      "requiresEventContext": true
    },
    {
      "id": "customer-360",
      "name": "Customer 360",
