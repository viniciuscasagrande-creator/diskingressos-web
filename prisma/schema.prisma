generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Producer {
  id                    Int                    @id @default(autoincrement())
  name                  String
  document              String                 @unique
  status                String                 @default("ativo")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  users                 User[]
  events                Event[]
  audits                AuditLog[]
  lots                  Lot[]
  orders                Order[]
  participants          Participant[]
  tickets               Ticket[]
  checkIns              CheckIn[]
  posTerminals          PosTerminal[]
  posTransactions       PosTransaction[]
  financialTransactions FinancialTransaction[]
  payouts               Payout[]
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  passwordHash String
  role         String
  status       String     @default("ativo")
  producerId   Int?
  producer     Producer?  @relation(fields: [producerId], references: [id])
  lastLogin    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  audits       AuditLog[]
}

model Event {
  id                    Int                    @id @default(autoincrement())
  code                  String                 @unique
  title                 String
  venue                 String
  city                  String
  date                  String
  endDate               String?
  totalCents            Int                    @default(0)
  sales                 Int                    @default(0)
  available             Int                    @default(0)
  courtesy              Int                    @default(0)
  occupancy             Float                  @default(0)
  cover                 String                 @default("nature")
  badge                 String?
  status                String                 @default("ativo")
  description           String?
  category              String?
  visibility            String                 @default("publico")
  producerId            Int
  producer              Producer               @relation(fields: [producerId], references: [id])
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  lots                  Lot[]
  orders                Order[]
  participants          Participant[]
  tickets               Ticket[]
  checkIns              CheckIn[]
  posTerminals          PosTerminal[]
  posTransactions       PosTransaction[]
  financialTransactions FinancialTransaction[]

  @@index([producerId])
  @@index([producerId, status])
}

model Lot {
  id         Int       @id @default(autoincrement())
  name       String
  sector     String?
  priceCents Int
  capacity   Int
  sold       Int       @default(0)
  status     String    @default("ativo")
  startsAt   DateTime?
  endsAt     DateTime?
  producerId Int
  eventId    Int
  producer   Producer  @relation(fields: [producerId], references: [id])
  event      Event     @relation(fields: [eventId], references: [id])
  tickets    Ticket[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([producerId])
  @@index([eventId])
  @@index([producerId, eventId])
}

model Order {
  id             Int                    @id @default(autoincrement())
  code           String                 @unique
  buyerName      String
  buyerEmail     String
  buyerDocument  String?
  channel        String                 @default("online")
  paymentMethod  String
  status         String                 @default("pago")
  quantity       Int                    @default(1)
  grossCents     Int
  feeCents       Int                    @default(0)
  netCents       Int
  producerId     Int
  eventId        Int
  producer       Producer               @relation(fields: [producerId], references: [id])
  event          Event                  @relation(fields: [eventId], references: [id])
  tickets        Ticket[]
  posTransaction PosTransaction?
  financialTx    FinancialTransaction[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([producerId])
  @@index([eventId])
  @@index([producerId, eventId])
  @@index([producerId, status])
}

model Participant {
  id           Int       @id @default(autoincrement())
  name         String
  email        String?
  document     String?
  phone        String?
  facialStatus String    @default("nao-cadastrado")
  producerId   Int
  eventId      Int
  producer     Producer  @relation(fields: [producerId], references: [id])
  event        Event     @relation(fields: [eventId], references: [id])
  tickets      Ticket[]
  checkIns     CheckIn[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([producerId])
  @@index([eventId])
  @@index([producerId, eventId])
}

model Ticket {
  id            Int          @id @default(autoincrement())
  code          String       @unique
  status        String       @default("valido")
  type          String       @default("inteira")
  priceCents    Int
  producerId    Int
  eventId       Int
  orderId       Int
  lotId         Int?
  participantId Int?
  producer      Producer     @relation(fields: [producerId], references: [id])
  event         Event        @relation(fields: [eventId], references: [id])
  order         Order        @relation(fields: [orderId], references: [id])
  lot           Lot?         @relation(fields: [lotId], references: [id])
  participant   Participant? @relation(fields: [participantId], references: [id])
  checkIns      CheckIn[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([producerId])
  @@index([eventId])
  @@index([orderId])
  @@index([participantId])
}

model CheckIn {
  id            Int          @id @default(autoincrement())
  status        String       @default("presente")
  gate          String?
  method        String       @default("qr")
  operatorName  String?
  checkedAt     DateTime     @default(now())
  producerId    Int
  eventId       Int
  participantId Int?
  ticketId      Int?
  producer      Producer     @relation(fields: [producerId], references: [id])
  event         Event        @relation(fields: [eventId], references: [id])
  participant   Participant? @relation(fields: [participantId], references: [id])
  ticket        Ticket?      @relation(fields: [ticketId], references: [id])

  @@index([producerId])
  @@index([eventId])
  @@index([participantId])
  @@index([ticketId])
}

model PosTerminal {
  id             Int              @id @default(autoincrement())
  code           String           @unique
  name           String
  status         String           @default("online")
  operatorName   String?
  batteryPercent Int?
  lastSyncAt     DateTime?
  producerId     Int
  eventId        Int?
  producer       Producer         @relation(fields: [producerId], references: [id])
  event          Event?           @relation(fields: [eventId], references: [id])
  transactions   PosTransaction[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([producerId])
  @@index([eventId])
}

model PosTransaction {
  id            Int         @id @default(autoincrement())
  code          String      @unique
  amountCents   Int
  paymentMethod String
  status        String      @default("aprovada")
  producerId    Int
  eventId       Int
  terminalId    Int
  orderId       Int?        @unique
  producer      Producer    @relation(fields: [producerId], references: [id])
  event         Event       @relation(fields: [eventId], references: [id])
  terminal      PosTerminal @relation(fields: [terminalId], references: [id])
  order         Order?      @relation(fields: [orderId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([producerId])
  @@index([eventId])
  @@index([terminalId])
}

model Payout {
  id           Int                    @id @default(autoincrement())
  code         String                 @unique
  amountCents  Int
  status       String                 @default("solicitado")
  bankAccount  String?
  notes        String?
  requestedAt  DateTime               @default(now())
  paidAt       DateTime?
  producerId   Int
  producer     Producer               @relation(fields: [producerId], references: [id])
  transactions FinancialTransaction[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([producerId])
  @@index([producerId, status])
}

model FinancialTransaction {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  type        String
  category    String
  description String
  amountCents Int
  status      String    @default("liquidado")
  occurredAt  DateTime  @default(now())
  producerId  Int
  eventId     Int?
  orderId     Int?
  payoutId    Int?
  producer    Producer  @relation(fields: [producerId], references: [id])
  event       Event?    @relation(fields: [eventId], references: [id])
  order       Order?    @relation(fields: [orderId], references: [id])
  payout      Payout?   @relation(fields: [payoutId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([producerId])
  @@index([eventId])
  @@index([orderId])
  @@index([payoutId])
  @@index([producerId, type])
}

model AuditLog {
  id         Int       @id @default(autoincrement())
  userId     Int?
  user       User?     @relation(fields: [userId], references: [id])
  producerId Int?
  producer   Producer? @relation(fields: [producerId], references: [id])
  action     String
  resource   String
  resourceId String?
  status     String    @default("success")
  ip         String?
  details    String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([producerId])
}
